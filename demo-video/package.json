{
  "name": "fastuse-motion-graphics",
  "version": "1.0.0",
  "description": "High-end 4K Motion Graphic Video for fastuse",
  "scripts": {
    "start": "remotion preview src/index.ts",
    "build": "remotion render src/index.ts FastuseDemo out/fastuse_demo_4k.mp4 --gl=angle",
    "build:fast": "remotion render src/index.ts FastuseDemo out/fastuse_demo_1080p.mp4 --scale=0.5 --gl=angle",
    "still": "remotion still src/index.ts FastuseDemo out/hero_frame.png --frame=600"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.260",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.260"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
