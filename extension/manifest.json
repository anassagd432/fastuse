{
  "manifest_version": 3,
  "name": "fastuse browser",
  "version": "0.0.1",
  "description": "Lets your AI agent use your own browser quickly, in its own tab group. Works with fastuse on your computer.",
  "minimum_chrome_version": "116",
  "key": "",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["nativeMessaging", "tabs", "tabGroups", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "fastuse browser", "default_popup": "popup.html" }
}
